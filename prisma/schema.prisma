// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Chat {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Document {
  id       String @id @default(cuid())
  userId   String
  filename String
  /// The document's own title, for citation display. Null for plain-text sources and for
  /// PDFs whose layout offers no candidate; the filename is the fallback.
  title    String?
  /// sha256 of the source bytes — the same identity PageExtraction is keyed by, so the
  /// pages a model re-read for this file are reachable from the document row.
  ///
  /// Unique per user, so re-ingesting a file replaces rather than duplicates. Nullable,
  /// and Postgres treats nulls as distinct, leaving plain-text sources unconstrained.
  ///
  /// The join it enables is time-varying: PageExtraction's key includes the model and the
  /// prompt hash, so it finds what the cache holds *now*, never what produced a given
  /// chunk — that is Chunk.source.
  fileHash String?

  status    String   @default("pending") // pending | processing | success | error
  createdAt DateTime @default(now())

  chunks Chunk[]

  @@unique([userId, fileHash])
  @@index([userId])
}

/// A retrievable passage, and everything known about where its text came from.
///
/// The provenance columns are frozen at write time because none of them is recoverable
/// afterwards: the extraction cache is keyed by the *current* model and prompt, so it
/// cannot say what produced a chunk written last month.
model Chunk {
  id         String @id @default(cuid())
  documentId String
  content    String
  index      Int    // position within the document — for ordering and dedupe
  /// The embedding model, written from EMBEDDING_MODEL on every insert. No default: a
  /// default is what a column nothing writes falls back to, which would be silently wrong
  /// in exactly the situation this column exists to describe.
  model      String

  /// 1-based physical page, matching PdfPage.page and PageExtraction.page. Null for
  /// sources that have no pages. A single number rather than a range because the chunker
  /// never merges across a page boundary — the same rule keeps pageLabel and source
  /// single-valued.
  page       Int?
  /// The page number the document prints on itself, when it disagrees with `page` — front
  /// matter numbered i, ii, iii, or an offprint starting at 47. Null when they agree, so a
  /// citation renders `pageLabel ?? page`.
  pageLabel  String?
  /// The section heading this chunk sits under. Prefixed to the embedded text but
  /// deliberately not to `content`: what is retrieved should carry its context, what is
  /// quoted should not.
  heading    String?
  /// Which path produced this text — "layout" | "model" | "text". Model extraction falls
  /// back page by page and silently, so without this a fully enriched document and one
  /// where every page fell back are indistinguishable.
  source     String?
  /// "heading" | "paragraph" | "table". A table arrives as one block and must never be
  /// split or truncated, which is a retrieval-time decision needing this flag.
  kind       String?
  /// Approximate, content.length / 4, for filling a prompt budget rather than a fixed
  /// match count — chunk size is wildly non-uniform, since a whole table is one chunk. Too
  /// rough to police the embedding input limit; storeChunks measures that itself.
  tokenCount Int?

  embedding Unsupported("vector(1536)")?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, index])
  @@index([documentId])
}

/// One page re-read by a model because the layout defeated geometric reconstruction.
///
/// A cache and an audit trail, never a job queue: a row is written only once a page has
/// come back well formed and about the right page. Nothing records a read in progress or
/// a failed one, so an interrupted read leaves no trace to clean up and a rejected page is
/// simply read again on the next ingest. Deleting a collected row silently re-pays for it.
///
/// Per page rather than per document, so raising a detector threshold only pays for the
/// one page it newly flags.
///
/// Keyed by content, not by user — two users uploading identical bytes share a row, which
/// is not a leak: a hit already requires possessing the same file.
model PageExtraction {
  fileHash   String // sha256 of the PDF bytes
  page       Int // 1-based, matches PdfPage.page
  model      String
  promptHash String // sha256 of the prompt template, so editing it re-reads
  /// Why the detector flagged this page — the LayoutAssessment reasons, copied at write.
  /// Read by people rather than by code: it answers why a badly cited page was sent to a
  /// model at all. A column rather than JSON so that stays a query.
  reasons String[]

  /// The model's raw blocks, exactly as returned rather than as mapped paragraphs — this
  /// is the only part of the pipeline that cannot be reproduced by re-running code, so
  /// when a citation looks wrong it says whether the model or the chunker was at fault.
  ///
  /// Faithfulness is re-checked on read against the page as parsed: a stored row is
  /// trusted for cost, not for correctness.
  blocks Json

  createdAt DateTime @default(now())

  // The content is the identity, and rows are written once and never changed.
  @@id([fileHash, page, model, promptHash])
}

